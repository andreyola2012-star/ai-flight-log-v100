[Unit]
Description=Tesla V100 SXM2: persistence on, power limit to stock maximum (300W)
After=nvidia-persistenced.service
Wants=nvidia-persistenced.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/nvidia-smi -pm 1
# V100 SXM2 штатный лимит 300 Вт (дефолт драйвера); снята старая планка 187 Вт от RTX 3060
ExecStart=/usr/bin/nvidia-smi -pl 300

[Install]
WantedBy=multi-user.target
